#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,matrix-transform = &imprint_function_row_full_bottom_row; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp F1     &kp F2    &kp F3         &kp F4    &kp F5     &kp F6          &kp F7   &kp F8       &kp F9      &kp F10    &kp F11  &kp F12
&kp PG_DN  &kp N1    &kp N2         &kp N3    &kp N4     &kp N5          &kp N6   &kp N7       &kp N8      &kp N9     &kp N0   &kp PG_UP
&kp LALT   &kp X     &kp V          &kp L     &kp C      &kp W           &kp K    &kp H        &kp G       &kp F      &kp Q    &mt LALT MINUS
&kp LCTRL  &kp U     &kp I          &kp A     &kp E      &kp O           &kp S    &kp N        &kp R       &kp T      &kp D    &mt RCTRL Z
&kp LSHFT  &kp LBKT  &mt LALT SEMI  &kp APOS  &kp P      &kp Y           &kp B    &kp M        &kp COMMA   &kp DOT    &kp J    &kp RSHFT
&kp LGUI   &kp HOME  &kp UP         &kp DOWN  &trans                              &trans       &kp LEFT    &kp RIGHT  &kp END  &kp RGUI
                                &kp SPACE &kp TAB    &kp LC(Y)               &kp DEL  &kp BSPC     &kp RETURN
                                &mo 2     &kp ESC    &kp K_APP               &kp INS  &kp LA(TAB)  &mo 1
            >;
        };

        Sonderzeichen {
            bindings = <
&kp PRINTSCREEN  &trans        &trans          &trans            &trans             &trans             &trans           &trans            &trans            &trans             &trans           &trans
&trans           &trans        &kp C_PREV      &kp C_PLAY_PAUSE  &kp C_MUTE         &kp C_VOL_DN       &kp C_VOL_UP     &kp C_MUTE        &kp C_NEXT        &trans             &trans           &trans
&kp TILDE        &kp GRAVE     &kp LC(LA(N7))  &kp LC(LA(N8))    &kp RIGHT_BRACKET  &kp LS(N1)         &kp LS(MINUS)    &kp KP_MINUS      &kp LC(LA(N9))    &kp LC(LA(N0))     &kp EQUAL        &kp LALT
&trans           &kp KP_SLASH  &kp NUBS        &kp LS(N0)        &kp LS(DOT)        &kp LS(N8)         &kp LS(N9)       &kp LS(BACKSLASH) &kp LS(COMMA)     &kp LS(NUBS)       &kp KP_MULTIPLY  &kp RCTRL
&trans           &kp LS(N4)    &kp LS(N5)      &kp LS(SLASH)     &kp LC(LA(Q))      &kp LS(N6)         &kp RC(LA(NUBS)) &kp RA(MINUS)     &kp LS(N2)        &kp BACKSLASH      &kp RA(E)        &trans
&trans           &kp LS(N3)    &trans          &kp N0            &trans                                                 &trans            &kp UP            &kp DOWN           &kp HOME         &trans
                                           &trans          &trans             &trans                     &trans           &trans            &DEL
                                           &trans          &trans             &trans                     &trans           &trans            &trans
            >;
        };

        Numpad_Cursor {
            bindings = <
&kp F13      &kp F14       &kp F15         &kp F16       &kp F17       &kp F18                 &kp F19          &kp F20   &kp F21       &kp F22          &kp F23          &kp F24						
&bt BT_CLR   &bt BT_SEL 0  &kp BSPC        &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans           &kp BSPC  &kp KP_SLASH  &kp KP_MULTIPLY  &trans           &trans
&sys_reset   &kb LC(X)     &kp DEL         &kp UP        &kp PG_UP     &kp ESC                 &kp LS(COMMA)    &kp N7    &kp N8        &kp N9           &kp TAB          &sys_reset
&bootloader  &kp LC(C)     &kp LEFT        &kp DOWN      &kp RIGHT     &kp RETURN              &kp N0           &kp N4    &kp N5        &kp N6           &kp KP_MINUS     &kp DOT
&to 4        &kp LC(V)     &kp HOME        &kp TAB       &kp PG_DN     &kp END                 &kp LS(DOT)      &kp N1    &kp N2        &kp N3           &kp KP_PLUS      &to 4
&to 3        &kp LA(BCPC)  &kp LS(LC(TAB)) &kp LC(TAB)   &trans                                                 &trans    &kp N0        &kp COMMA        &kp LS(N0)       &to 3
                                       &trans        &trans        &trans                          &trans           &trans           &trans
                                       &trans        &trans        &trans                          &trans           &trans           &trans
            >;
        };

        BT_Mouse_Layer {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans           &trans    &trans        &trans           &trans           &trans
&trans  &trans        &trans        &trans        &trans        &trans            &trans           &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans           &trans           &trans
&trans  &trans        &trans        &trans        &trans        &trans            &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &sys_reset
&trans  &trans        &mkp RCLK     &mkp MCLK     &mkp LCLK     &trans            &trans           &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &bootloader
&trans  &trans        &trans        &trans        &trans        &trans            &trans           &trans           &trans           &trans           &trans           &trans
&trans  &trans        &trans        &trans        &trans                                           &trans           &trans           &trans           &trans           &trans
                                         &trans    &trans   &trans                    &trans  &trans  &trans
                                         &trans    &trans  &trans                     &trans  &trans  &trans
            >;
        };

        factory_test {
            bindings = <
&kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5            &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp N1
&kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7            &kp N8  &kp N9  &kp N0  &kp N1  &kp N2  &kp N3
&kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9            &kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
&kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp N1            &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7
&kp N8  &kp N9  &kp N0  &kp N1  &kp N2  &kp N3            &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9
&kp N0  &kp N1  &kp N2  &kp N3  &kp N4                            &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                                &kp N1  &kp N2  &kp N3    &kp N4  &kp N5  &kp N6
                                &kp N7  &kp N8  &kp N9    &kp N0  &kp N1  &kp N2
            >;
        };
    };
};

// right hand trackball configuration
// &trackball_peripheral_listener {
//    input-processors =
//     activate layer 3 within 500ms of the trackball moving
//     <&zip_temp_layer 3 500>;
// };
//left hand trackball configuration

&trackball_central_listener {
    input-processors =
        // multiply sensitivity by 1, divide by 3 (make it slower for scrolling),,
        <&zip_xy_scaler 1 3>,
        // make this trackball output scrolling events by default instead of cursor movement,,
        <&zip_xy_to_scroll_mapper>,
        // invert vertical scrolling so that the view moves in the same direction as the top of the trackball.,,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
